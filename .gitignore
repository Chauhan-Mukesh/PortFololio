# ================================================================================
# Comprehensive .gitignore for Web Development Portfolio Project
# ================================================================================
# This .gitignore covers multiple development scenarios for the portfolio project
# including static web development, Node.js, Python, PHP, and testing frameworks.
# ================================================================================

# ================================================================================
# DEPENDENCIES & PACKAGE MANAGERS
# ================================================================================

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npmrc
.yarnrc
package-lock.json
yarn.lock
.pnpm-debug.log*
.pnpm-store/

# Python dependencies
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PHP dependencies
vendor/
composer.lock
composer.phar

# ================================================================================
# BUILD OUTPUTS & COMPILED FILES
# ================================================================================

# General build outputs
build/
dist/
out/
.output/
*.min.js
*.min.css
*.map

# Webpack & bundlers
.webpack/
.parcel-cache/
.cache/
.nuxt/
.next/
.svelte-kit/

# TypeScript
*.tsbuildinfo
.tscache/

# ================================================================================
# TESTING FRAMEWORKS & COVERAGE
# ================================================================================

# Cypress
cypress/videos/
cypress/screenshots/
cypress/downloads/
cypress.config.js.bak

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Jest
coverage/
*.lcov
.nyc_output/

# General test outputs
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# ================================================================================
# DEVELOPMENT TOOLS & LINTING
# ================================================================================

# ESLint
.eslintcache

# Stylelint
.stylelintcache

# Prettier
.prettierignore.bak

# SonarQube
.sonar/
.scannerwork/

# ================================================================================
# ENVIRONMENT & CONFIGURATION
# ================================================================================

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production

# Configuration files
config.local.json
config.production.json
.secrets

# Database
*.db
*.sqlite
*.sqlite3

# ================================================================================
# SERVER & RUNTIME
# ================================================================================

# Python virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Flask
instance/
.webassets-cache

# PHP runtime
.phpunit.result.cache
phpunit.xml
.php_cs.cache

# ================================================================================
# EDITOR & IDE FILES
# ================================================================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# JetBrains IDEs
.idea/
*.swp
*.swo

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*~
*.swp
*.swo
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

